<Page x:Class="Gist.App.Views.CollectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Gist.App.Views">
    <Grid x:Name="RootGrid" Margin="24" AutomationProperties.AutomationId="CollectionPage_Root"
          AutomationProperties.Name="Collection page" AutomationProperties.AccessibilityView="Content">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: collection name (spec §2 "page header shows Library/collection name"). -->
        <TextBlock x:Name="TitleText" Grid.Row="0" Style="{StaticResource TitleTextBlockStyle}"
                   TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="CollectionPage_Title" />

        <!-- Command bar (spec §5): same commands as Library minus Import/Filter/AddToCollection/Encrypt. -->
        <CommandBar x:Name="Commands" Grid.Row="1" DefaultLabelPosition="Right" HorizontalAlignment="Left"
                    IsDynamicOverflowEnabled="True" Margin="0,8,0,8" Background="Transparent" TabIndex="0">
            <AppBarButton x:Name="SortButton" Icon="Sort" Label="Sort"
                          AutomationProperties.AutomationId="CollectionPage_SortButton"
                          ToolTipService.ToolTip="Sort">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <RadioMenuFlyoutItem x:Name="SortNewest" Text="Date Added (Newest)" GroupName="Sort" Tag="DateAddedNewest" Click="OnSortClick" />
                        <RadioMenuFlyoutItem x:Name="SortOldest" Text="Date Added (Oldest)" GroupName="Sort" Tag="DateAddedOldest" Click="OnSortClick" />
                        <RadioMenuFlyoutItem x:Name="SortTitleAz" Text="Title A–Z" GroupName="Sort" Tag="TitleAZ" Click="OnSortClick" />
                        <RadioMenuFlyoutItem x:Name="SortTitleZa" Text="Title Z–A" GroupName="Sort" Tag="TitleZA" Click="OnSortClick" />
                        <RadioMenuFlyoutItem x:Name="SortAuthorAz" Text="Author A–Z" GroupName="Sort" Tag="AuthorAZ" Click="OnSortClick" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="RemoveButton" Icon="Delete" Label="Remove" Click="OnRemove"
                          AutomationProperties.AutomationId="CollectionPage_RemoveButton"
                          ToolTipService.ToolTip="Remove from Collection (Delete)" />
            <AppBarButton x:Name="OpenButton" Icon="OpenWith" Label="Open" Click="OnOpen"
                          AutomationProperties.AutomationId="CollectionPage_OpenButton"
                          ToolTipService.ToolTip="Open (Enter)" />
            <AppBarButton x:Name="TagsButton" Icon="Tag" Label="Tags" Click="OnTags"
                          AutomationProperties.AutomationId="CollectionPage_TagsButton"
                          ToolTipService.ToolTip="Manage Tags" />
            <CommandBar.Content>
                <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed"
                              Margin="8,0" AutomationProperties.Name="Working"
                              AutomationProperties.AutomationId="CollectionPage_BusyRing" />
            </CommandBar.Content>
        </CommandBar>

        <!-- Loading -->
        <StackPanel x:Name="LoadingPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                    AutomationProperties.AutomationId="CollectionLoading">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock Text="Loading collection" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Item list: same row template as the Library screen (spec §5 "one row template"). -->
        <ListView x:Name="ItemsList" Grid.Row="2" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="True"
                  Visibility="Collapsed" IsItemClickEnabled="False" TabIndex="1"
                  SelectionChanged="OnSelectionChanged" DoubleTapped="OnListDoubleTapped"
                  ContainerContentChanging="OnContainerContentChanging"
                  AutomationProperties.AutomationId="CollectionPage_List" AutomationProperties.Name="Collection items">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:LibraryRow">
                    <Grid Padding="4,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Authors}" Visibility="{x:Bind AuthorsVisibility}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <FontIcon Grid.Column="1" Glyph="&#xE72E;" FontSize="14" Visibility="{x:Bind LockVisibility}"
                                  VerticalAlignment="Center" AutomationProperties.Name="Encrypted at rest"
                                  ToolTipService.ToolTip="Encrypted at rest"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ContextFlyout>
                <MenuFlyout x:Name="RowMenu" Opening="OnRowMenuOpening">
                    <MenuFlyoutItem Text="Open in Reader" Click="OnOpen" />
                    <MenuFlyoutItem Text="Open in Flow View" Click="OnOpenFlow" />
                    <MenuFlyoutItem Text="Manage Tags…" Click="OnTags" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Remove from Collection…" Click="OnRemove" />
                </MenuFlyout>
            </ListView.ContextFlyout>
        </ListView>

        <!-- Empty state (spec §4.4 shape, §5 wording: "This collection is empty."). -->
        <StackPanel x:Name="EmptyPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    Visibility="Collapsed" AutomationProperties.AutomationId="CollectionPage_EmptyState">
            <FontIcon Glyph="&#xE8F1;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
