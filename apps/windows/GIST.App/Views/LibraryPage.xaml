<Page x:Class="Gist.App.Views.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Gist.App.Views">
    <Page.KeyboardAccelerators>
        <!-- Ctrl+F focuses the search box (spec 4.2). -->
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearch" />
    </Page.KeyboardAccelerators>
    <Grid x:Name="RootGrid" Margin="24" AutomationProperties.AutomationId="LibraryPage_Root"
          AutomationProperties.Name="Library page" AutomationProperties.AccessibilityView="Content">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title left, search right (spec 4.1). -->
        <StackPanel Grid.Row="0" Spacing="8">
        <!-- Fixed-text warning when a removal left stored files behind (never paths/titles). -->
        <InfoBar x:Name="RemoveWarningBar" Severity="Warning" IsOpen="False" IsClosable="True"
                 Closed="OnRemoveWarningClosed" Loaded="OnRemoveWarningLoaded"
                 AutomationProperties.AutomationId="LibraryPage_RemoveWarning" />
        <Grid x:Name="HeaderGrid" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Library" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" Width="320" PlaceholderText="Search library"
                            QueryIcon="Find" TextChanged="OnSearchTextChanged" TabIndex="0"
                            AutomationProperties.Name="Search library"
                            AutomationProperties.AutomationId="LibraryPage_SearchBox"
                            ToolTipService.ToolTip="Search library (Ctrl+F)" />
        </Grid>
        </StackPanel>

        <!-- Command bar, order per spec 4.1. Items 5-9 are last, so they overflow first at narrow widths. -->
        <CommandBar x:Name="Commands" Grid.Row="1" DefaultLabelPosition="Right" HorizontalAlignment="Left"
                    IsDynamicOverflowEnabled="True" Margin="0,8,0,8" Background="Transparent" TabIndex="0">
            <AppBarButton x:Name="ImportFileButton" Icon="OpenFile" Label="Import File" Click="OnImportFile"
                          AutomationProperties.AutomationId="LibraryPage_ImportFileButton"
                          ToolTipService.ToolTip="Import File (Ctrl+O)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="ImportUrlButton" Label="Import URL" Click="OnImportUrl"
                          AutomationProperties.AutomationId="LibraryPage_ImportUrlButton"
                          ToolTipService.ToolTip="Import URL">
                <AppBarButton.Icon><FontIcon Glyph="&#xE774;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="SortButton" Icon="Sort" Label="Sort"
                          AutomationProperties.AutomationId="LibraryPage_SortButton"
                          ToolTipService.ToolTip="Sort">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <RadioMenuFlyoutItem x:Name="SortNewest" Text="Date Added (Newest)" GroupName="Sort" Tag="DateAddedNewest" Click="OnSortClick" />
                        <RadioMenuFlyoutItem x:Name="SortOldest" Text="Date Added (Oldest)" GroupName="Sort" Tag="DateAddedOldest" Click="OnSortClick" />
                        <RadioMenuFlyoutItem x:Name="SortTitleAz" Text="Title A–Z" GroupName="Sort" Tag="TitleAZ" Click="OnSortClick" />
                        <RadioMenuFlyoutItem x:Name="SortTitleZa" Text="Title Z–A" GroupName="Sort" Tag="TitleZA" Click="OnSortClick" />
                        <RadioMenuFlyoutItem x:Name="SortAuthorAz" Text="Author A–Z" GroupName="Sort" Tag="AuthorAZ" Click="OnSortClick" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="FilterButton" Icon="Filter" Label="Filter"
                          AutomationProperties.AutomationId="LibraryPage_FilterButton"
                          ToolTipService.ToolTip="Filter by tag">
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="FilterFlyout" Opening="OnFilterFlyoutOpening" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="AddToCollectionButton" Icon="Add" Label="Add to Collection"
                          AutomationProperties.AutomationId="LibraryPage_AddToCollectionButton"
                          ToolTipService.ToolTip="Add to Collection">
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="CollectionFlyout" Opening="OnCollectionFlyoutOpening" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="EncryptButton" Label="Encrypt" Click="OnEncrypt"
                          AutomationProperties.AutomationId="LibraryPage_EncryptButton"
                          ToolTipService.ToolTip="Encrypt selected items">
                <AppBarButton.Icon><FontIcon Glyph="&#xE72E;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="RemoveButton" Icon="Delete" Label="Remove" Click="OnRemove"
                          AutomationProperties.AutomationId="LibraryPage_RemoveButton"
                          ToolTipService.ToolTip="Remove selected items (Delete)" />
            <AppBarButton x:Name="OpenButton" Icon="OpenWith" Label="Open" Click="OnOpen"
                          AutomationProperties.AutomationId="LibraryPage_OpenButton"
                          ToolTipService.ToolTip="Open (Enter)" />
            <AppBarButton x:Name="TagsButton" Icon="Tag" Label="Tags" Click="OnTags"
                          AutomationProperties.AutomationId="LibraryPage_TagsButton"
                          ToolTipService.ToolTip="Manage Tags" />
            <CommandBar.Content>
                <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed"
                              Margin="8,0" AutomationProperties.Name="Working"
                              AutomationProperties.AutomationId="LibraryPage_BusyRing" />
            </CommandBar.Content>
        </CommandBar>

        <!-- Loading -->
        <StackPanel x:Name="LoadingPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                    AutomationProperties.AutomationId="LibraryLoading">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock Text="Loading your library" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Item list: virtualised, extended selection with checkboxes. -->
        <ListView x:Name="ItemsList" Grid.Row="2" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="True"
                  Visibility="Collapsed" IsItemClickEnabled="False" TabIndex="1"
                  SelectionChanged="OnSelectionChanged" DoubleTapped="OnListDoubleTapped"
                  KeyDown="OnListKeyDown" ContainerContentChanging="OnContainerContentChanging"
                  AutomationProperties.AutomationId="LibraryPage_List" AutomationProperties.Name="Library items">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:LibraryRow">
                    <Grid Padding="4,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Authors}" Visibility="{x:Bind AuthorsVisibility}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <FontIcon Grid.Column="1" Glyph="&#xE72E;" FontSize="14" Visibility="{x:Bind LockVisibility}"
                                  VerticalAlignment="Center" AutomationProperties.Name="Encrypted at rest"
                                  ToolTipService.ToolTip="Encrypted at rest"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ContextFlyout>
                <MenuFlyout x:Name="RowMenu" Opening="OnRowMenuOpening">
                    <MenuFlyoutItem Text="Open in Reader" Click="OnOpen" />
                    <MenuFlyoutItem Text="Open in Flow View" Click="OnOpenFlow" />
                    <MenuFlyoutItem Text="Manage Tags…" Click="OnTags" />
                    <MenuFlyoutItem x:Name="RowEncrypt" Text="Encrypt…" Click="OnEncrypt" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Remove…" Click="OnRemove" />
                </MenuFlyout>
            </ListView.ContextFlyout>
        </ListView>

        <!-- Empty states (spec 4.4): title and message come from the view model. -->
        <StackPanel x:Name="EmptyPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    Visibility="Collapsed" AutomationProperties.AutomationId="LibraryPage_EmptyState">
            <FontIcon x:Name="EmptyIcon" Glyph="&#xE8F1;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <Button x:Name="EmptyImportButton" Content="Import file…" Click="OnImportFile" HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="LibraryPage_EmptyImportButton" />
        </StackPanel>

        <!-- Blocking: encryption key cannot be recovered (ADR-016). Deliberately no destructive action. -->
        <StackPanel x:Name="CorruptPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                    MaxWidth="480" Visibility="Collapsed" AutomationProperties.AutomationId="LibraryKeyCorrupt">
            <FontIcon Glyph="&#xE72E;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Encrypted items can't be unlocked" Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="KeyStorePage_Title" />
            <TextBlock Text="GIST couldn't recover the key that protects your encrypted items. Nothing has been deleted and no new key has been created. Try again, or restore your GIST data from a backup."
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="Retry" Click="OnRetry" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="KeyStorePage_RetryButton" />
        </StackPanel>

        <!-- Retryable failure (key store or store temporarily unavailable, or a generic error). -->
        <StackPanel x:Name="ErrorPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                    MaxWidth="480" Visibility="Collapsed" AutomationProperties.AutomationId="LibraryError">
            <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ErrorTitle" Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="KeyStorePage_Title" />
            <TextBlock x:Name="ErrorDetail" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="Retry" Click="OnRetry" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="KeyStorePage_RetryButton" />
        </StackPanel>
    </Grid>
</Page>
