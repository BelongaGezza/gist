<Application x:Class="Gist.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- W3 theme engine (spec §3.1): light-theme defaults, kept in sync at runtime by
                 Gist.App.Theming.ThemeApplier the moment AppServices.Theme resolves. Declared here
                 so a lookup never fails before that first Apply call. -->
            <SolidColorBrush x:Key="GistBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="GistForeground" Color="#1A1A1A" />
            <SolidColorBrush x:Key="GistAccent" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="GistSecondaryText" Color="#1A1A1A" Opacity="0.6" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
