<Window x:Class="WinUiHello.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIST WinUI hello spike">
    <NavigationView IsSettingsVisible="True" PaneDisplayMode="Left">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Library" Icon="Library" />
            <NavigationViewItem Content="Collections" Icon="Folder" />
        </NavigationView.MenuItems>
        <StackPanel Margin="24" Spacing="8">
            <TextBlock x:Name="Label" Text="Hello from WinUI 3" FontSize="28" />
            <TextBlock x:Name="FfiStatus" Text="gist_ffi.dll: not checked" />
        </StackPanel>
    </NavigationView>
</Window>
